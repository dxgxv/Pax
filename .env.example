# GEMINI_API_KEY: Clave de API de Google Gemini para diagnóstico asistido en taller.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PASSWORD_JEFE: Contraseña para desbloquear el Panel de Jefatura y Finanzas (por defecto: valdivia2026)
PASSWORD_JEFE="valdivia2026"

# TELEFONO_TALLER: Número de WhatsApp del Jefe de Taller para alertas de Pana Fulminante (formato internacional sin +)
TELEFONO_TALLER="56912345678"

# APP_URL: URL pública donde se aloja la aplicación para generar enlaces NFC / QR
APP_URL="http://localhost:3000"
